{
  "expo": {
    "name": "Vices",
    "slug": "vices",
    "scheme": "vice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1c1713"
    },
    "ios": {
      "bundleIdentifier": "com.fintdigital.vices",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vices uses your location to point you toward the nearest place to satisfy your vice.",
        "NSMotionUsageDescription": "Vices uses motion sensors to power the live compass needle."
      }
    },
    "android": {
      "package": "com.fintdigital.vices",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1c1713"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-updates",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vices needs photo library access to update your profile picture.",
          "cameraPermission": "Vices needs camera access to take a profile picture."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Compass",
              "label": "Vices Compass",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "Mini compass pointing to your nearest vice",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickVice",
              "label": "Quick Vice",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "description": "Tap to open your favorite vice",
              "resizeMode": "none"
            }
          ]
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/07f1038b-528c-4d19-b078-3418f3732620"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07f1038b-528c-4d19-b078-3418f3732620"
      }
    },
    "owner": "sirhobbys-organization",
    "privacyPolicyUrl": "https://sirhobby.github.io/vice-privacy/"
  }
}
